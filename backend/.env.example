# Copy to .env and fill in. Never commit a real .env.
#
# Database. Local dev defaults to sqlite:///./lms.db when unset.
# For Postgres (e.g. Render): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Required in production — long random string. Dev falls back to an
# ephemeral key (logins won't survive a restart).
SECRET_KEY=

# Email (password reset). If unset, reset emails are logged, not sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
FROM_EMAIL=
FROM_NAME=LMS System

# Frontend URL used in password-reset links
FRONTEND_URL=http://localhost:5173
